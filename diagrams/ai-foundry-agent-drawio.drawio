                </mxCell>
                <mxCell id="hs3_hq_tt_b" value="HQ Datacenter — private ExpressRoute circuit.&#xa;Dedicated link via telco — no public internet hops.&#xa;Low latency, predictable bandwidth, SLA-backed.&#xa;Mission-critical workloads connect privately to Azure." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=30;fontFamily=Architects Daughter;fontStyle=0;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="hs3_L4" vertex="1">
