                <mxCell id="hs3_hq_tt_h" value="🏛️ HQ — ExpressRoute" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=30;fontFamily=Architects Daughter;fontStyle=0;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="hs3_L4" vertex="1">
