                </mxCell>
                <mxCell id="hs3_branch_tt_b" value="VPN Branch Office — site-to-site IPsec tunnel.&#xa;On-prem VPN Router connects to Azure VPN Gateway.&#xa;Encrypted over public internet — affordable branch link.&#xa;Traffic routs through Hub to reach spoke workloads." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=30;fontFamily=Architects Daughter;fontStyle=0;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="hs3_L3" vertex="1">
