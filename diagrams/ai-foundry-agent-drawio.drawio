                </mxCell>
                <mxCell id="hs3_spoke_tt_b" value="Two spoke VNets peered to Hub — workload isolation.&#xa;Spoke 1 (Apps): 10.1.0.0/16 — application VMs.&#xa;Spoke 2 (Data): 10.2.0.0/16 — data-tier VMs.&#xa;Spokes have no direct peering — isolated from each other by default." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=30;fontFamily=Architects Daughter;fontStyle=0;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" parent="hs3_L2" vertex="1">
