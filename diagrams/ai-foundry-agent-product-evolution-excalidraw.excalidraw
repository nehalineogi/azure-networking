      "boundElements": [
        {
          "id": "A9LnfZ3zk8wYGFgArZMdG",
          "type": "arrow"
        }
      ],
      "updated": 1776952064397,
      "link": null,
      "locked": false,
      "text": "\nMicrosoft.CognitiveServices/accounts/{name}/projects/{name}/capabilityHosts/{name}\n\n {\n   \"properties\": {\n     \"threadStorageConnections\":   [\"conn-name\"],  ← required your Cosmos DB  (threads/history)\n     \"vectorStoreConnections\":     [\"conn-name\"],  ← required your AI Search  (vectors/files)\n     \"storageConnections\":         [\"conn-name\"],  ← required your Storage    (file uploads)\n     \"aiServicesConnections\":      [\"conn-name\"]   ← optional, BYO Azure OpenAI\n   }\n }",
      "fontSize": 34.285715738932275,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nMicrosoft.CognitiveServices/accounts/{name}/projects/{name}/capabilityHosts/{name}\n\n {\n   \"properties\": {\n     \"threadStorageConnections\":   [\"conn-name\"],  ← required your Cosmos DB  (threads/history)\n     \"vectorStoreConnections\":     [\"conn-name\"],  ← required your AI Search  (vectors/files)\n     \"storageConnections\":         [\"conn-name\"],  ← required your Storage    (file uploads)\n     \"aiServicesConnections\":      [\"conn-name\"]   ← optional, BYO Azure OpenAI\n   }\n }",
      "autoResize": true,
      "lineHeight": 1.25
    },
